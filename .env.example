# ==============================================================================
# Odikyu DNS Shield - Configuration Template
# Copy this file to .env and configure your values: cp .env.example .env
# ==============================================================================

# Google AI Studio API Key for Gemma-4-31b-it Website Inspection
GEMMA_API_KEY=your_google_ai_studio_api_key_here
GEMMA_MODEL_NAME=gemma-4-31b-it
GEMMA_API_BASE=https://generativelanguage.googleapis.com

# Server & Domain Configuration
SERVER_HOSTNAME=dns.odikyu.tech
DNS_LISTEN_IP=0.0.0.0
DNS_PORT=53

# Block Page / Warning Page Configuration
# IP returned for blocked sites (set to public IP of dns.odikyu.tech in production)
BLOCK_PAGE_IP=127.0.0.1
BLOCK_PAGE_PORT=80
BLOCK_PAGE_ALT_PORT=8080

# Threat Intelligence & Policy
BLOCK_SUSPICIOUS=true
AI_INSPECTION_ENABLED=true
AUTO_INSPECT_SUSPICIOUS=true

# Upstream DNS-over-HTTPS Server (RFC 8484)
DOH_SERVER=https://cloudflare-dns.com/dns-query

# Database & Feed Sync
THREAT_DB_PATH=threats.db
SYNC_INTERVAL_SECONDS=7200

# PhishTank feed (developer requirements: https://www.phishtank.com/developer_info)
# Default source: a Phishtank Lookup API instance (GET /urls bulk pull, no
# registration required). Set the base URL of your instance:
PHISHTANK_LOOKUP_URL=https://lookup.odikyu.tech
# Optional official-download application key (register at phishtank.com). When set,
# the official bulk download replaces the lookup instance and enables unlimited
# HTTP HEAD/ETag change checks (files update hourly, so unchanged files are never
# re-downloaded).
#PHISHTANK_API_KEY=your_phishtank_app_key
# Descriptive User-Agent identifying this application (required — generic agents
# get rate limited or extra security challenges). Applied to GET and HEAD requests.
PHISHTANK_USER_AGENT=odikyu-dns-shield/2.0 (+https://dns.odikyu.tech)
